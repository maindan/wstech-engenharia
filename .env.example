# URL final do site (sem barra no fim) — usada em SEO, sitemap e Open Graph
NEXT_PUBLIC_SITE_URL=https://wstechengenharia.com.br

# Chave do Web3Forms (https://web3forms.com) — o formulário de contato envia e-mail por aqui
NEXT_PUBLIC_WEB3FORMS_KEY=

# ID de editor do Google AdSense (ca-pub-XXXXXXXXXXXXXXXX). Vazio = nenhum anúncio é carregado
NEXT_PUBLIC_ADSENSE_CLIENT=
# IDs dos blocos de anúncio criados no painel do AdSense
NEXT_PUBLIC_ADSENSE_SLOT_1=
NEXT_PUBLIC_ADSENSE_SLOT_2=

# Google Analytics 4 (G-XXXXXXX). Vazio = sem analytics
NEXT_PUBLIC_GA_ID=
